[Unit]
Description=Intel Forecast Snapshot — weekly confidence snapshot
Documentation=https://github.com/bricerising/enterprise-software-playbook/blob/main/specs/006-intelligence-tool.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/intel forecast --snapshot --config %h/.config/intel/config.yaml

Environment=NODE_ENV=production
Environment=XDG_RUNTIME_DIR=%t

# Resource limits
MemoryMax=512M
TasksMax=64

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/intel %h/.local/run/intel %t/intel
