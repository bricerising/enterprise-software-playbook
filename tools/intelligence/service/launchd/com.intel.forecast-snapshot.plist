<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.intel.forecast-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INTEL_BIN__</string>
        <string>forecast</string>
        <string>--snapshot</string>
        <string>--config</string>
        <string>__HOME__/.config/intel/config.yaml</string>
    </array>

    <!-- Weekly: Sunday at 03:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/intel-forecast.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/intel-forecast.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>XDG_RUNTIME_DIR</key>
        <string>__HOME__/.local/run</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
